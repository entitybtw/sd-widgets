[Unit]
Description=sd-widgets daemon
Documentation=https://git.entitybtw.ru/entitybtw/sd-widgets
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
# Starts hidden: the tray and `sdw-daemon --show` bring the window back.
ExecStart=/usr/bin/sdw-daemon --hidden
Restart=on-failure
RestartSec=2
# The daemon needs access to the session bus for notifications and to the
# display for capture, so do not enable any filesystem sandboxing here.
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=graphical-session.target
